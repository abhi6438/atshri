# Copy this file to .env and fill in your values
# Never commit .env to version control

# FastAPI backend base URL
VITE_API_URL=http://localhost:8000

# When true, homepage/admin load site content from GET /content (database).
# When false (default), the app uses bundled files in src/data (your full static dataset).
VITE_USE_API_CONTENT=false

# Cloudinary cloud name for photo uploads
VITE_CLOUDINARY_CLOUD_NAME=
